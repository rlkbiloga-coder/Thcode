{
  "name": "Thcode — Mobile IDE",
  "short_name": "Thcode",
  "id": "/",
  "description": "IDE mobile open-source: editor, terminal Linux, plugins, Git/GitHub real, IA e preview.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0e13",
  "theme_color": "#a100ff",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": [
    "productivity",
    "developer",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/*",
            "application/*",
            "image/*"
          ]
        }
      ]
    }
  }
}
