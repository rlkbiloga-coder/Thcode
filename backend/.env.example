# Thcode Backend v2.5.0 — Production Environment Template
# Copie este arquivo para .env e preencha todos os valores obrigatórios
# NUNCA commite o arquivo .env original!
# Comando para gerar token seguro:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================================================
# BACKEND CONFIG — Obrigatório
# ============================================================================
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Token de autenticação — Gere com comando acima
# IMPORTANTE: Mude este valor antes de ir para produção!
THCODE_API_TOKEN=troque-por-um-token-criptograficamente-forte-gerado

# Workspace directory — Onde os projetos são salvos
WORKSPACE_DIR=./workspace

# ============================================================================
# CORS & SECURITY — Obrigatório em produção
# ============================================================================

# Origens permitidas para requisições (CSV)
# Exemplo: ALLOWED_ORIGINS=https://rlkbiloga-coder.github.io,https://seu-dominio.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://rlkbiloga-coder.github.io/Thcode

# Rate limiting
RATE_WINDOW_MS=60000
RATE_MAX=300

# Máximo de sessões de terminal simultâneas por token
MAX_TERMINALS=5

# ============================================================================
# GITHUB INTEGRATION — Opcional (sem GitHub, funciona com erro honesto)
# ============================================================================

# GitHub Personal Access Token — escopo: repo, read:user
# Gere em: https://github.com/settings/tokens
# Sem este token: git/github operations retornarão 503
GITHUB_TOKEN=

# GitHub OAuth App (para login via GitHub — opcional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================================
# IA PROVIDERS — Opcional (cada um é independente)
# ============================================================================

# OpenAI API Key
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude)
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini
# https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Groq (Recomendado: grátis, rápido, sem cartão de crédito)
# https://console.groq.com
GROQ_API_KEY=

# OpenRouter (acesso a múltiplos modelos)
# https://openrouter.ai
OPENROUTER_API_KEY=

# ============================================================================
# STRIPE — Opcional (para pagamento Thcode PRO)
# ============================================================================

# Stripe Secret Key (sk_live_xxx para produção, sk_test_xxx para teste)
# Nunca use a chave pública!
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ============================================================================
# ANALYTICS — Opcional
# ============================================================================

# Ativar coleta de analytics (consentimento do usuário obrigatório)
ANALYTICS_ENABLED=true

# ============================================================================
# DEPLOY PLATFORMS — Use conforme seu escolhido
# ============================================================================

# Railway.app
# DATABASE_URL=postgresql://user:pass@host/db  (se usar banco)

# Render
# RENDER_EXTERNAL_URL=https://seu-app.onrender.com

# Fly.io
# FLY_APP_NAME=thcode-app

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Nível de log: debug, info, warn, error
LOG_LEVEL=info

# Enviar logs para serviço externo (opcional)
# SENTRY_DSN=https://...@sentry.io/...

# ============================================================================
# DICAS DE SEGURANÇA
# ============================================================================
#
# 1. Gere um novo THCODE_API_TOKEN:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. Cada token deve ser único por ambiente (dev, staging, prod)
#
# 3. Revise ALLOWED_ORIGINS antes de deployer
#
# 4. Nunca compartilhe .env com ninguém
#
# 5. Use variáveis de ambiente seguras em produção:
#    - Railway: secrets na dashboard
#    - Render: environment variables
#    - Fly: fly secrets
#    - VPS: use gerenciador de secrets (Vault, etc)
#
# 6. Mude THCODE_API_TOKEN regularmente
#
# 7. Use HTTPS sempre em produção (certificado SSL/TLS)
#
# 8. Mantenha Node.js e dependências atualizadas
#
# ============================================================================
