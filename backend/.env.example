# Thcode Backend — configuração
# Copie para .env e preencha. NUNCA commite o .env real.

PORT=8080
HOST=0.0.0.0

# Token de autenticação do frontend para a API.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
THCODE_API_TOKEN=troque-por-um-token-forte

# Diretório do workspace (arquivos dos projetos). Criado se não existir.
WORKSPACE_DIR=./workspace

# Máximo de sessões de terminal simultâneas por token
MAX_TERMINALS=5

# GitHub (opcional): PAT do servidor OU OAuth App
# PAT precisa dos scopes: repo, read:user
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# IA (opcional): as chaves ficam SÓ no backend
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Rate limit (janela ms e máx de requisições)
RATE_WINDOW_MS=60000
RATE_MAX=300
STRIPE_SECRET_KEY=sk_test_xxx   # Stripe real (checkout PRO)

# Infraestrutura (opcional, validada com conexões reais)
CORS_ORIGINS=https://rlkbiloga-coder.github.io
DATABASE_URL=
REDIS_URL=
E2B_API_KEY=
E2B_WEBHOOK_SECRET=
# Referências Railway no serviço thcode-backend:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# WORKSPACE_DIR=/app/workspace (volume deve ser montado no mesmo caminho)

# E2B namespace exclusivo para este workspace; template vazio usa o padrão do SDK
E2B_WORKSPACE_ID=thcode
E2B_TEMPLATE=
