# ═══════════════════════════════════════════════════════════════════════════════
# THCODE v3.0 — PRODUÇÃO AVANÇADA COM RAILWAY
# ═══════════════════════════════════════════════════════════════════════════════

# ── NODE / ENVIRONMENT ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── DATABASE ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@postgres.railway.internal:5432/thcode
POSTGRES_HOST=postgres.railway.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=thcode
DATABASE_POOL_SIZE=20
ENABLE_QUERY_LOGGING=true
QUERY_SLOW_THRESHOLD=1000

# ── REDIS ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:password@redis.railway.internal:6379/0
REDIS_HOST=redis.railway.internal
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0
CACHE_STRATEGY=multi-tier
REDIS_CLUSTER_ENABLED=false

# ── S3 STORAGE ──────────────────────────────────────────────────────────────────
S3_ENABLED=true
S3_BUCKET_ASSETS=thcode-assets-prod
S3_BUCKET_BACKUPS=thcode-backups-prod
S3_ENDPOINT=https://s3.railway.app
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# ── OBSERVABILIDADE ────────────────────────────────────────────────────────────
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=true
ENABLE_AUDIT_LOG=true
AUDIT_LOG_LEVEL=all

# ── SENTRY (Error Tracking) ─────────────────────────────────────────────────────
SENTRY_ENABLED=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=0.1

# ── DATADOG (Monitoring) ────────────────────────────────────────────────────────
DATADOG_ENABLED=true
DATADOG_API_KEY=your_datadog_api_key
DATADOG_SITE=datadoghq.com
DATADOG_METRICS_ENABLED=true
DATADOG_TRACE_ENABLED=true

# ── JAEGER (Distributed Tracing) ────────────────────────────────────────────────
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=jaeger.railway.internal
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLE_RATE=0.1

# ── SEGURANÇA ───────────────────────────────────────────────────────────────────
CORS_ENABLED=true
CORS_ORIGINS=*
CSP_ENABLED=true
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100

# ── AUTENTICAÇÃO ────────────────────────────────────────────────────────────────
JWT_SECRET=${{ secret() }}
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
ENABLE_2FA=true
ENABLE_OAUTH2=true
ENABLE_SAML=true
ENABLE_API_KEY_ROTATION=true

# ── FEATURES & APIS ─────────────────────────────────────────────────────────────
ENABLE_WEBSOCKET=true
WEBSOCKET_HEARTBEAT=30000
ENABLE_STREAMING=true
ENABLE_GRAPHQL=true
GRAPHQL_PLAYGROUND=true
ENABLE_REST_API=true
API_VERSION=3.0.0

# ── WEBHOOKS ────────────────────────────────────────────────────────────────────
WEBHOOK_RETRY_MAX=5
WEBHOOK_TIMEOUT=30000
STRIPE_WEBHOOK_ENABLED=true
STRIPE_WEBHOOK_SECRET=whsec_test_123

# ── COMPRESSION & PERFORMANCE ───────────────────────────────────────────────────
COMPRESSION_TYPE=brotli
COMPRESSION_LEVEL=11
KEEP_ALIVE_TIMEOUT=65000
REQUEST_TIMEOUT=30000
MAX_REQUEST_SIZE=100mb
WORKERS=4

# ── DATA MANAGEMENT ─────────────────────────────────────────────────────────────
ENABLE_DATA_VERSIONING=true
ENABLE_SOFT_DELETES=true
ENABLE_DATA_MASKING=true
GDPR_ENABLED=true

# ── API & INTEGRATIONS ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-your-key
GITHUB_TOKEN=ghp_your-token
STRIPE_API_KEY=sk_live_your-key
CDN_ENABLED=true
ANALYTICS_ENABLED=true

# ── DEPLOYMENT ──────────────────────────────────────────────────────────────────
API_DOMAIN=${{ thcode-backend.RAILWAY_PUBLIC_DOMAIN }}
DEPLOYMENT_ENV=production
DEPLOYMENT_REGION=sfo

